# ============================================================
# 复制本文件为 .env 并填写。所有配置也可随时修改后重启生效。
# ============================================================

# ==== Instagram 监控（监控别人的公开账号，用 instaloader）====
# 要监控的目标账号用户名（不带 @），多个用逗号分隔，例如 user1,user2
IG_TARGETS=
# 你的 Instagram 小号用户名（用于登录 instaloader，拉取公开数据）
# 注意：用小号，不要用你本人主力号，避免被封
IG_LOGIN_USER=
# 你的 Instagram 小号密码
IG_LOGIN_PASS=

# ==== AI 文案生成（任意 OpenAI 兼容接口，换供应商只改这三行）====
# base_url 需为 OpenAI 格式、以 /v1 结尾
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# ==== 真人检测（vision）专用：可选手动覆盖，用于发现层 reject_real_person ====
# 不填则用 AI_MODEL。注意 grok 全系不支持图片输入，需指向支持 vision 的模型
# （已实测：gemini-2.5-flash 可用；gpt-4o / glm-4v / claude 系亦可）
# VISION_MODEL=gemini-2.5-flash
# VISION_API_KEY=

# ==== 语音识别（生成字幕）====
# provider: api = 走 AI_BASE_URL 的兼容 /audio/transcriptions 接口
#           local = 本地 faster-whisper（免费，需 pip install -r requirements-local-asr.txt）
ASR_PROVIDER=local
ASR_MODEL=whisper-1
# 识别语言：zh / en / auto（auto=自动检测）
ASR_LANGUAGE=zh
# local 模式用的模型大小：tiny / base / small / medium / large-v3
ASR_LOCAL_MODEL=small

# ==== Telegram 通知 ====
# 1) 找 @BotFather 创建 bot 拿 token  2) 给你的 bot 发一条消息  3) 运行 python -m bot.main --setup 可自动获取 chat_id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# 国内网络无法直连时，可换成自建反代地址
TELEGRAM_API_BASE=https://api.telegram.org
# 可选 http 代理，例如 http://127.0.0.1:7890（留空不使用）
TELEGRAM_PROXY=

# ==== 发布浏览器代理 ====
# 默认空=强制直连国内创作者中心（忽略进程里的 HTTP_PROXY / 小火箭环境代理）
# 增强模式/TUN 拦的是全部流量，仍需在小火箭里给 *.kuaishou.com 等加 DIRECT，见 README
# 只有确实要让 Chromium 走代理时才填，例如 http://127.0.0.1:7890
PUBLISH_PROXY=
